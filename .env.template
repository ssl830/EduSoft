# GitHub Actions Environment Variables Template
# 复制此文件内容到GitHub仓库的Secrets配置中

# ===========================================
# 阿里云镜像仓库配置 (必需)
# ===========================================
ACR_USERNAME=your_aliyun_username
ACR_PASSWORD=your_aliyun_password

# ===========================================
# 服务器SSH配置 (必需)
# ===========================================
# SSH私钥 - 用于连接所有服务器
SSH_PRIVATE_KEY=|
  -----BEGIN OPENSSH PRIVATE KEY-----
  your_ssh_private_key_content_here
  -----END OPENSSH PRIVATE KEY-----

# ===========================================
# 服务器IP地址配置 (必需)
# ===========================================
# 开发环境服务器
DEV_HOST=dev.edusoft.example.com
# 或者使用IP: DEV_HOST=192.168.1.100

# 生产环境服务器集群
PROD_HOST_1=prod1.edusoft.example.com
PROD_HOST_2=prod2.edusoft.example.com  
PROD_HOST_3=prod3.edusoft.example.com
# 或者使用IP:
# PROD_HOST_1=10.0.1.10
# PROD_HOST_2=10.0.1.11
# PROD_HOST_3=10.0.1.12

# ===========================================
# 应用配置密钥 (必需)
# ===========================================
# OpenAI API密钥 (AI服务使用)
OPENAI_API_KEY=sk-your_openai_api_key_here

# 数据库配置
DB_USERNAME=edusoft_user
DB_PASSWORD=your_secure_db_password

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here

# ===========================================
# 可选配置
# ===========================================
# Slack通知配置 (可选)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# 邮件通知配置 (可选)
SMTP_HOST=smtp.example.com
SMTP_USERNAME=notifications@edusoft.example.com
SMTP_PASSWORD=your_smtp_password

# 监控配置 (可选)
GRAFANA_API_KEY=your_grafana_api_key
PROMETHEUS_URL=http://prometheus.edusoft.example.com

# ===========================================
# 生产环境特定配置
# ===========================================
# 域名配置
PRODUCTION_DOMAIN=edusoft.example.com
STAGING_DOMAIN=staging.edusoft.example.com

# SSL证书配置 (如果使用HTTPS)
SSL_CERTIFICATE_PATH=/etc/ssl/certs/edusoft.crt
SSL_PRIVATE_KEY_PATH=/etc/ssl/private/edusoft.key

# ===========================================
# Kubernetes配置
# ===========================================
# Kubeconfig内容 (base64编码)
KUBE_CONFIG_DATA=LS0tLS1CRUdJTi...your_base64_encoded_kubeconfig...

# 镜像拉取策略
IMAGE_PULL_POLICY=Always

# 命名空间
K8S_NAMESPACE=edusoft

# ===========================================
# 安全配置
# ===========================================
# 容器镜像扫描配置
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=1

# 代码质量门禁
SONAR_TOKEN=your_sonarqube_token
SONAR_PROJECT_KEY=edusoft-microservices

# ===========================================
# 性能测试配置
# ===========================================
# 负载测试配置
LOAD_TEST_DURATION=300s
LOAD_TEST_VUS=100
LOAD_TEST_TARGET_URL=https://edusoft.example.com

# ===========================================
# 备份和恢复配置
# ===========================================
# 备份存储配置
BACKUP_S3_BUCKET=edusoft-backups
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_S3_REGION=us-west-2

# ===========================================
# 如何在GitHub中配置这些Secrets:
# ===========================================
# 1. 进入GitHub仓库
# 2. 点击 Settings -> Secrets and variables -> Actions
# 3. 点击 "New repository secret"
# 4. 输入密钥名称和值
# 5. 点击 "Add secret"
# 
# 注意事项:
# - 密钥名称必须与上面的变量名完全匹配
# - SSH私钥需要包含完整的密钥内容（包括头部和尾部）
# - 多行内容需要保持原始格式
# - 不要在密钥值中包含引号，除非它们是值的一部分
# ===========================================
